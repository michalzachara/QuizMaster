{
  "name": "quiz-master",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx server.ts --dev",
    "build": "prisma generate && next build --webpack",
    "start": "tsx server.ts",
    "lint": "eslint",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "prisma migrate deploy",
    "format": "prettier --write \"{app,components,lib,scripts,tests,types}/**/*.{ts,tsx,css,mjs}\" \"*.{ts,mjs,json}\"",
    "format:check": "prettier --check \"{app,components,lib,scripts,tests,types}/**/*.{ts,tsx,css,mjs}\" \"*.{ts,mjs,json}\""
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^7.0.3",
    "@neon/config": "^1.11.3",
    "@neon/env": "^1.6.15",
    "@next/env": "^16.4.5",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.70.0",
    "motion": "^14.10.1",
    "next": "16.4.5",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "prettier": "3.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
