# Pooled connection for the Node.js application. Never commit real credentials.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/neondb?sslmode=verify-full"
# Optional direct connection for Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=verify-full"
AUTH_URL="http://localhost:3100"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="REPLACE_WITH_RANDOM_SECRET"
PORT=3100
